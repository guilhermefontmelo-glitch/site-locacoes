{
  // ============================================================================
  // AMBIENTE PYTHON & INTERPRETADOR (.venv)
  // ============================================================================
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.autoImportCompletions": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["."],

  // ============================================================================
  // RUFF - LINTER & FORMATTER PYTHON
  // ============================================================================
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.rulers": [100],
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.nativeServer": "on",
  "ruff.configuration": "${workspaceFolder}/pyproject.toml",

  // ============================================================================
  // DJLINT - TEMPLATES HTML5 + DJANGO + HTMX
  // ============================================================================
  "files.associations": {
    "**/templates/**/*.html": "django-html",
    "templates/**/*.html": "django-html"
  },
  "[django-html]": {
    "editor.defaultFormatter": "monosans.djlint",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    }
  },
  "djlint.useVenv": true,
  "djlint.configuration": "${workspaceFolder}/pyproject.toml",
  "emmet.includeLanguages": {
    "django-html": "html"
  },

  // ============================================================================
  // CSS3 MODERNO & JAVASCRIPT VANILLA (ES6+)
  // ============================================================================
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "css.validate": true,
  "html.format.indentInnerHtml": true,

  // ============================================================================
  // HIGIENE DE ARQUIVOS, CODIFICACAO & PERFORMANCE DO WORKSPACE
  // ============================================================================
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".ruff_cache": true,
    ".pytest_cache": true,
    ".mypy_cache": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/venv": true,
    "**/.vercel": true,
    "**/node_modules": true,
    "**/staticfiles": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true
  }
}
