# ==============================================================================
# ROCHA CONSTRUTORA & LOCAÇÕES — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Uso local: copie este arquivo para `.env` na raiz do projeto.
# Na Vercel: cadastre DJANGO_SECRET_KEY (e domínios customizados, se houver) em
# Project Settings -> Environment Variables.
#
# Gerar chave forte para produção:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ==============================================================================

# 1. AMBIENTE DJANGO
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=gere-uma-chave-local-segura-aqui-com-pelo-menos-50-caracteres
DJANGO_DEBUG=True

# Hosts e origens extras separados por vírgula (na Vercel, *.vercel.app é detectado,
# mas adicione aqui seu domínio próprio quando conectar, ex: rochaconstrutora.com.br)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Rota não previsível para o Django Admin
DJANGO_ADMIN_URL=painel-rocha-gestao/

# 2. BANCO DE DADOS (Opcional para Landing Page na Vercel; SQLite local por padrão)
DATABASE_URL=sqlite:///db.sqlite3

# 3. HARDENING HTTP & ANTI-ABUSO
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# 4. CANAIS OFICIAIS DE CONVERSÃO (E.164 apenas dígitos: DDI + DDD + Número)
ROCHA_WHATSAPP_CONSTRUTORA=5588992258807
ROCHA_WHATSAPP_LOCADORA=5588994248183
