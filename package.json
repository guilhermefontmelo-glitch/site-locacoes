{
  "name": "rocha-construtora-plataforma",
  "version": "0.2.0",
  "description": "Pipeline Tailwind CSS v4 CLI para a Landing Page Rocha Construtora & Locações",
  "private": true,
  "scripts": {
    "css:dev": "tailwindcss -i ./src/input.css -o ./static/css/tailwind.css --watch=always",
    "css:build": "tailwindcss -i ./src/input.css -o ./static/css/tailwind.css --minify"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
